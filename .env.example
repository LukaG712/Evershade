# Evershade - Environment Configuration
# Copy this file to .env and fill in your values.

# ─── API Keys (Required) ──────────────────────────────────────────────
# Generate secure keys: openssl rand -hex 32

HUB_API_KEY=Greenie-dev-key-change-me
Slinker_API_KEY=Slinker-dev-key-change-me
Trapper_API_KEY=Trapper-dev-key-change-me
GOBBER_API_KEY=Gobber-dev-key-change-me
SNEAKER_API_KEY=Sneaker-dev-key-change-me
HIDER_API_KEY=Hider-dev-key-change-me
POLTERGEIST_API_KEY=Poltergeist-dev-key-change-me
SHREWD_API_KEY=Shrewd-dev-key-change-me
ENCRYPTION_KEY=change-me-in-production

# ─── Optional Configuration ───────────────────────────────────────────

# OpenAI API key for Shrewd LLM abstraction
OPENAI_API_KEY=

# Ollama settings for local LLM inference
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b

# Redis password for cluster support (leave empty for no password)
REDIS_PASSWORD=

# Workspace path (use absolute path in production)
WORKSPACE_PATH=./workspace

# Slinker settings
MAX_CONCURRENT_WORKERS=1
ISOLATION_MODE=worktree
JUNIE_BIN=junie
REFINE_PROMPT=false

# Obsidian vault path for Gobber knowledge graph
OBSIDIAN_VAULT_PATH=./obsidian-vault

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
