# Evershade — Example Configuration
# Copy this file to .env and fill in your values.
#
# Naming convention: EVERSHADE_<SERVICE>_<SETTING>
# Legacy variable names are still supported but deprecated.
# Run `evershade config validate` to check for deprecated names.

# ─── Deployment Mode ───────────────────────────────────────────────
# "desktop" = loopback only (default). "server" = bind to all interfaces.
EVERSHADE_MODE=desktop
EVERSHADE_BIND_ADDRESS=127.0.0.1
EVERSHADE_PUBLIC_URL=http://localhost:8080

# ─── Service API Keys ──────────────────────────────────────────────
# Generate secure keys: openssl rand -hex 32
# NEVER use the example values in production.

EVERSHADE_GREENIE_API_KEY=change-me-greenie
EVERSHADE_SLINKER_API_KEY=change-me-slinker
EVERSHADE_TRAPPER_API_KEY=change-me-trapper
EVERSHADE_GOBBER_API_KEY=change-me-gobber
EVERSHADE_SNEAKER_API_KEY=change-me-sneaker
EVERSHADE_HIDER_API_KEY=change-me-hider
EVERSHADE_POLTERGEIST_API_KEY=change-me-poltergeist
EVERSHADE_SHREWD_API_KEY=change-me-shrewd

# Legacy aliases (deprecated — remove after migration):
# HUB_API_KEY=change-me-greenie
# Slinker_API_KEY=change-me-slinker
# Trapper_API_KEY=change-me-trapper

# ─── Hider Encryption ─────────────────────────────────────────────
# REQUIRED for Hider service. Used to encrypt all secrets at rest (AES-256-GCM).
# Generate a strong random key: openssl rand -hex 32
# WARNING: If you lose this key, all encrypted secrets are permanently lost.
EVERSHADE_ENCRYPTION_KEY=change-me-encryption-key

# ─── LLM Providers (Shrewd) ───────────────────────────────────────
# Cloud providers (optional — leave empty to use local models only)
EVERSHADE_OPENAI_API_KEY=
EVERSHADE_OPENAI_BASE_URL=https://api.openai.com/v1
EVERSHADE_ANTHROPIC_API_KEY=
EVERSHADE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
EVERSHADE_GOOGLE_API_KEY=
EVERSHADE_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ─── Local Model (Ollama) ─────────────────────────────────────────
# For Docker on Linux, use extra_hosts or set to your Ollama host IP.
# For Docker Desktop (Mac/Windows), host.docker.internal works by default.
EVERSHADE_OLLAMA_URL=http://host.docker.internal:11434
EVERSHADE_OLLAMA_MODEL=gemma4:12b

# Shrewd settings
EVERSHADE_SHREWD_DEFAULT_MODEL=llama3
EVERSHADE_SHREWD_REQUEST_TIMEOUT=60

# ─── Slinker Settings ─────────────────────────────────────────────
EVERSHADE_WORKSPACE_PATH=./workspace
EVERSHADE_MAX_CONCURRENT_WORKERS=1
EVERSHADE_ISOLATION_MODE=worktree
EVERSHADE_JUNIE_BIN=junie
EVERSHADE_REFINE_PROMPT=false

# ─── Trapper Settings ─────────────────────────────────────────────
EVERSHADE_SCRAPE_TIMEOUT=30000
EVERSHADE_CRAWL_MAX_DEPTH=10
EVERSHADE_CRAWL_MAX_PAGES=100
EVERSHADE_CRAWL_MAX_CONCURRENCY=5
EVERSHADE_BROWSER_HEADLESS=true

# ─── Obsidian Vault (Gobber) ──────────────────────────────────────
# Path to your Obsidian vault for knowledge graph indexing (optional).
EVERSHADE_OBSIDIAN_VAULT_PATH=./obsidian-vault

# ─── Redis (Trapper) ──────────────────────────────────────────────
# Only needed if running Redis externally. In Compose mode, Redis is managed automatically.
EVERSHADE_REDIS_PASSWORD=

# ─── Notification Delivery (Poltergeist) ──────────────────────────
# Slack Incoming Webhook URL
EVERSHADE_SLACK_WEBHOOK_URL=

# Discord Webhook URL
EVERSHADE_DISCORD_WEBHOOK_URL=

# SMTP settings for email notifications
EVERSHADE_SMTP_HOST=localhost
EVERSHADE_SMTP_PORT=587
EVERSHADE_SMTP_USER=
EVERSHADE_SMTP_PASSWORD=
EVERSHADE_SMTP_FROM=noreply@evershade.local
EVERSHADE_SMTP_TLS=true

# Telegram Bot Token (from @BotFather)
EVERSHADE_TELEGRAM_BOT_TOKEN=

# Poltergeist settings
EVERSHADE_POLTERGEIST_MAX_RETRIES=3
EVERSHADE_POLTERGEIST_REQUEST_TIMEOUT=30

# ─── Workflow Engine (Greenie) ────────────────────────────────────
# Path to the workflow SQLite database (default: Greenie/data/workflows.db)
EVERSHADE_GREENIE_WORKFLOW_DB_PATH=

# File change trigger poll interval in seconds (default: 10)
EVERSHADE_WORKFLOW_FILE_POLL_INTERVAL=10

# ─── Agent Workstations (Greenie) ─────────────────────────────────
# Path to the workstation SQLite database (default: Greenie/data/workstations.db)
EVERSHADE_GREENIE_WORKSTATION_DB_PATH=

# Gateway URL for terminal and desktop access (default: http://localhost:8080)
EVERSHADE_WORKSTATION_GATEWAY_URL=http://localhost:8080

# API token for workstation access validation (optional, uses GREENIE_API_KEY if set)
EVERSHADE_GREENIE_API_TOKEN=

# ─── MCP & Plugins (Greenie) ──────────────────────────────────────
# Data directory for MCP server config and plugin registry (default: data/)
EVERSHADE_GREENIE_DATA_DIR=./data

# ─── Activity Timeline (Greenie) ──────────────────────────────────
# Path to the activity timeline SQLite database (default: data/timeline.db)
EVERSHADE_GREENIE_TIMELINE_DB_PATH=

# Path to the credential rotation history database (default: data/credentials.db)
EVERSHADE_GREENIE_CREDENTIALS_DB_PATH=

# ─── Alerting (Sneaker) ───────────────────────────────────────────
# Path to the alerts SQLite database (default: data/alerts.db)
EVERSHADE_SNEAKER_ALERTS_DB_PATH=

# Data directory for Sneaker (default: Sneaker/data/)
EVERSHADE_SNEAKER_DATA_DIR=./data

# ─── Logging ──────────────────────────────────────────────────────
EVERSHADE_LOG_LEVEL=INFO
